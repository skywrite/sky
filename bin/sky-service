#!/usr/bin/env bash

FILE_LOCK=/tmp/sky-service.lock

if test -f "$FILE_LOCK"; then
    echo "  sky-service running. Exiting."
    exit 0
fi

touch $FILE_LOCK

cleanup () {
  rm $FILE_LOCK
}

trap cleanup EXIT


## launchd doesn't source shell profiles, so ensure bun is in PATH
export PATH="$HOME/.bun/bin:$HOME/.bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

if ! command -v bun &> /dev/null
then
  echo "bun could not be found. Exiting."
  exit 1
fi

# Derive repo root from this script's real location: bin/sky-service → repo/
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SKY_ROOT="$SCRIPT_DIR/.."

# Log directory; each start of the service gets its own timestamped pair
LOG_DIR="/tmp/sky-service"
mkdir -p "$LOG_DIR"

cd "$SKY_ROOT/src"

# The service watches its own source and leaves with this code when it wants
# to start again — a change it waited to land until nothing was running, its
# twelve hours up, the person asking (src/service/reload.ts). A fresh process
# each time, so nothing carries over. Any other exit ends this loop, and
# launchd's KeepAlive starts the launcher over.
RELOAD=3

while :; do
  TIMESTAMP=$(date +"%Y-%m-%dT%H-%M-%S")
  STDOUT_LOG="$LOG_DIR/$TIMESTAMP.stdout.log"
  STDERR_LOG="$LOG_DIR/$TIMESTAMP.stderr.log"
  echo "Sky service logs: $STDOUT_LOG"

  bun --env-file=.env run commands/all/service/start.ts >> "$STDOUT_LOG" 2>> "$STDERR_LOG"
  code=$?
  if [ "$code" -ne "$RELOAD" ]; then
    exit "$code"
  fi
done
