#!/usr/bin/env bash

## Sky CLI — convention-based command runner
## Usage: sky <command> [args...]
## Convention: sky day:start → commands/command-runner.ts day/start

if ! command -v bun &> /dev/null; then
  echo "bun could not be found. Exiting."
  exit 1
fi

if [ -z "$1" ]; then
  echo "Usage: sky <command> [args...]"
  exit 1
fi

command_name="$1"
shift

# Convert colons to slashes: day:start → day/start
command_path="${command_name//:///}"

pushd () { command pushd "$@" > /dev/null; }
popd () { command popd "$@" > /dev/null; }

export SKY_USER_CWD="$PWD"

# Derive code directory from this script's real location: bin/sky → sky/src/
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
pushd "$SCRIPT_DIR/../src"

bun --env-file=.env run commands/command-runner.ts "$command_path" "$@"
exit_code=$?
popd
exit $exit_code
