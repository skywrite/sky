#!/usr/bin/env bash

## Sky CLI — convention-based command runner
## Usage: sky <command> [args...]
## Convention: sky day:start → commands/command-runner.ts day/start

if ! command -v bun &> /dev/null; then
  echo "bun could not be found. Exiting."
  exit 1
fi

if [ -z "$1" ]; then
  echo "Usage: sky <command> [args...]"
  exit 1
fi

command_name="$1"
shift

# Convert colons to slashes: day:start → day/start
command_path="${command_name//:///}"

pushd () { command pushd "$@" > /dev/null; }
popd () { command popd "$@" > /dev/null; }

export SKY_USER_CWD="$PWD"
# Bridge legacy env vars until .zshrc is updated
[ -z "$SKY_DIR" ] && [ -n "$NB_DIR" ] && export SKY_DIR="$NB_DIR"
[ -z "$SKY_CODE_DIR" ] && [ -n "$NB_CODE_DIR" ] && export SKY_CODE_DIR="$(dirname "$NB_CODE_DIR")"
# SKY_CODE_DIR points to sky/, NB_CODE_DIR (legacy) points to sky/notebook/
if [ -n "$SKY_CODE_DIR" ]; then
  pushd "$SKY_CODE_DIR/notebook"
else
  pushd "$NB_CODE_DIR"
fi

bun run commands/command-runner.ts "$command_path" "$@"
exit_code=$?
popd
exit $exit_code
