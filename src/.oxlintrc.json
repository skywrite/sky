{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // Match deno lint disabled rules
    "no-explicit-any": "off",
    "no-unused-vars": "off",
    "prefer-const": "off",
    "no-constant-condition": "off",
    "require-await": "off",

    // oxlint equivalents of deno lint's "ban-types" and "no-empty-interface"
    "no-wrapper-object-types": "off",
    "no-empty-interface": "off",

    // Deno lint compatibility: existing code uses deno-lint-ignore comments that
    // oxlint doesn't recognize. These rules are disabled globally to match.
    // Remove these overrides when deno-lint-ignore comments are cleaned up.
    "no-useless-escape": "off",
    "no-control-regex": "off",
    "no-this-alias": "off",
    "require-yield": "off",
    "triple-slash-reference": "off",
    "no-new-array": "off"
  },
  // `extensions/` is listed because oxlint follows the extension's `shared` and
  // `lib` symlinks back into src/, which would lint that tree a second time.
  // The extension's own source IS linted — by `dev:lint:ext`, which names its
  // real directories explicitly (ignorePatterns do not apply to explicit paths).
  "ignorePatterns": ["node_modules", "_build", "dist", "deps/", "extensions/", "**/*.md", "**/*.min.js", "vendor"]
}
