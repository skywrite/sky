{
  "name": "sky",
  "type": "module",
  "scripts": {
    "dev:fmt": "cd .. && oxfmt --write src packages",
    "dev:fmt:check": "cd .. && oxfmt --check src packages",
    "dev:lint": "oxlint && bun run commands/all/lint/banned-apis.ts && bun run commands/all/lint/tasks.ts && bun run commands/all/lint/packages.ts",
    "dev:lint:banned": "bun run commands/all/lint/banned-apis.ts",
    "dev:lint:tasks": "bun run commands/all/lint/tasks.ts",
    "dev:lint:packages": "bun run commands/all/lint/packages.ts",
    "dev:test": "bun test --bail --timeout 60000 --path-ignore-patterns '**/*e2e*' && cd ../extensions/vscode && npm test",
    "dev:test:cli": "bun test --bail --timeout 60000 --path-ignore-patterns '**/*e2e*' --path-ignore-patterns '**/service/**'",
    "dev:test:unit": "bun test --bail --timeout 60000 --path-ignore-patterns '**/*e2e*'",
    "dev:test:web": "bun test 'service/' --bail --timeout 60000 --path-ignore-patterns '**/*e2e*'",
    "dev:test:vscode": "cd ../extensions/vscode && npm test",
    "dev:typecheck": "tsc --noEmit",
    "dev:schema:validate": "bun run commands/all/lint/schema.ts",
    "dev:schema:generate": "bun run commands/command-runner.ts dev/schema/generate"
  },
  "imports": {
    "#config": "./_shared-ts/config.ts",
    "#lib/*": "./lib/*",
    "#mcp/*": "./mcp/*",
    "#service/*": "./service/*",
    "#shared/*": "./_shared-ts/*",
    "#universal/*": "./_shared-ts/universal/*",
    "#commands/*": "./commands/*",
    "#test": "./test/mod.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.20",
    "@ai-sdk/openai": "4.0.20",
    "@anthropic-ai/sdk": "0.62.0",
    "@clack/core": "0.5.0",
    "@clack/prompts": "0.11.0",
    "@googlemaps/google-maps-services-js": "3.4.2",
    "@hono/node-server": "2.0.12",
    "@logtape/logtape": "2.3.0",
    "@mantine/core": "9.5.0",
    "@mantine/hooks": "9.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@ngrok/ngrok": "1.5.2",
    "@slack/web-api": "7.11.0",
    "ai": "7.0.37",
    "chokidar": "5.0.0",
    "cross-keychain": "1.1.0",
    "diff": "5.2.2",
    "execa": "7.1.1",
    "graphql": "16.12.0",
    "graphql-ws": "5.16.0",
    "graphql-yoga": "5.0.0",
    "handlebars": "4.7.9",
    "hono": "4.12.34",
    "imapflow": "1.6.5",
    "ink": "6.2.3",
    "jsonc-parser": "3.3.1",
    "marked": "16.1.1",
    "marked-terminal": "7.3.0",
    "mri": "1.2.0",
    "ms": "2.1.3",
    "ollama": "0.6.3",
    "ollama-ai-provider-v2": "4.0.1",
    "open": "9.1.0",
    "open-editor": "6.0.0",
    "openai": "5.12.2",
    "openai-agents": "1.1.0",
    "picocolors": "1.1.1",
    "picomatch": "4.0.5",
    "playwright": "1.56.1",
    "qrcode": "1.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "reflect-metadata": "0.2.2",
    "string-similarity": "4.0.2",
    "strip-ansi": "7.0.1",
    "twitter-api-v2": "1.14.2",
    "ws": "8.21.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.0",
    "zod": "4.3.5"
  },
  "overrides": {
    "axios": "1.19.0",
    "form-data": "4.0.6",
    "qs": "6.15.3",
    "ip-address": "10.3.1",
    "ws": "8.21.1",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "oxfmt": "^0.61.0",
    "oxlint": "1.76.0",
    "typescript": "^7.0.2"
  }
}
