# Sky environment variables
# Copy this file to .env and fill in your values.

ENV_FILE_LOADED=true

# Your preferred editor (used by commands that open files)
EDITOR=code

# --- AI providers (at least one needed for ai:chat and journal question generation) ---

OPENAI_API_KEY=
